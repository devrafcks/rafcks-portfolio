# Gmail que envia a mensagem do formulário. Precisa ser a conta da senha de app.
GMAIL_USER=

# Senha de app do Google (16 caracteres). Não é a senha da conta.
# Crie em https://myaccount.google.com/apppasswords com a verificação em duas etapas ligada.
GMAIL_APP_PASSWORD=

# Para quem a mensagem chega. Se ficar vazio, o destino é o GMAIL_USER.
CONTACT_TO=
